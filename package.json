{
  "name": "@yfwu2020/dsh-think-flow",
  "version": "0.3.2",
  "description": "DSH 思维链可视化：把模型的实时思考按 turn → step →（思考原文 + 工具调用）聚合成可读的右侧栏视图",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "author": "yfwu2020",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "chain-of-thought",
    "reasoning",
    "thinking",
    "visualization",
    "sidebar",
    "observability"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yfwu2020/dsh-think-flow.git"
  },
  "homepage": "https://github.com/yfwu2020/dsh-think-flow#readme",
  "bugs": {
    "url": "https://github.com/yfwu2020/dsh-think-flow/issues"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2 <5",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.7-rc <2",
    "@deepseek-ai/dsh-llm": ">=0.1.7-rc <2",
    "@deepseek-ai/schemastery": ">=3.18 <4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-theme": "0.1.7-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.7-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session": "0.1.7-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "@types/node": "^26.6.2",
    "esbuild": "0.28.2",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint:templates": "node scripts/lint-templates.mjs",
    "test": "node scripts/test.mjs",
    "test:trace": "node scripts/test.mjs trace",
    "test:titles": "node scripts/test.mjs titles",
    "test:routes": "node scripts/test.mjs routes",
    "test:translate": "node scripts/test.mjs translate",
    "test:client": "node scripts/test.mjs client",
    "preview": "npm run build && node scripts/preview/gen-ui-preview.mjs",
    "shots": "npm run build && node scripts/preview/gen-readme-shots.mjs",
    "align": "node scripts/preview/check-align.mjs",
    "test:build": "node --test tests/test-build.mjs",
    "prepack": "npm run build"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  }
}
